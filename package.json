{
  "name": "baby-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "mobile:install": "npm --prefix apps/mobile-expo ci --workspaces=false",
    "mobile:dev": "npm --prefix apps/mobile-expo run dev --",
    "mobile:build": "npm --prefix apps/mobile-expo run build --",
    "mobile:test": "npm --prefix apps/mobile-expo run test --",
    "mobile:typecheck": "npm --prefix apps/mobile-expo run typecheck --",
    "mobile:lint": "npm --prefix apps/mobile-expo run lint --",
    "mobile:doctor": "npm --prefix apps/mobile-expo run doctor --",
    "mobile:prebuild": "npm --prefix apps/mobile-expo run generate:native --",
    "mobile:ios": "npm --prefix apps/mobile-expo run ios --",
    "mobile:android": "npm --prefix apps/mobile-expo run android --",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
